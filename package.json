{
  "name": "coworking-backend-xp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "build": "tsc",
    "db:push": "prisma db push --skip-generate",
    "pretest:api": "cross-env NODE_ENV=test DATABASE_URL=file:./test-reservas.db prisma db push --skip-generate",
    "test:api": "cross-env NODE_ENV=test DATABASE_URL=file:./test-reservas.db JWT_SECRET=test-reservation-jwt-secret tsx --test tests/api/*.test.ts",
    "prestart": "npm run db:push",
    "start": "node dist/index.js",
    "predev": "npm run db:push",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test:e2e": "cross-env NODE_OPTIONS=--import=tsx cucumber-js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/cucumber": "^6.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3"
  }
}
